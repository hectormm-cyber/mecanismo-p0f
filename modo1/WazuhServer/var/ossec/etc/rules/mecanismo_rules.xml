<!--
  Regras do Mecanismo de deteccao e resposta (Modo 1).

  Origem: /var/log/mecanismo/verdicts.jsonl no MecanismoP0f, lido pelo agente Wazuh
  com log_format json. Cada linha e um veredito do prober.py (v6 ou superior), que
  traz "mecanismo": "modo1" e "srcip" (IP do ativo sondado).

  Faixa de IDs reservada: 100500 a 100599.

  | ID     | Veredito                   | Nivel | Contencao |
  | 100500 | qualquer (agrupadora)      | 0     | nao       |
  | 100501 | consistent                 | 3     | nao       |
  | 100502 | inconclusive               | 7     | nao       |
  | 100510 | mismatch-possible-clone    | 12    | sim       |
  | 100511 | unauthorized-fingerprinted | 12    | sim       |
  | 100512 | unauthorized-unresolved    | 12    | sim       |

  A decisao e do mecanismo; o Wazuh apenas classifica, registra e executa a
  active response configurada para 100510, 100511 e 100512 (ossec.conf do manager).
-->
<group name="mecanismo,">

  <rule id="100500" level="0">
    <decoded_as>json</decoded_as>
    <field name="mecanismo">^modo1$</field>
    <field name="verdict">\.+</field>
    <description>Mecanismo: veredito registrado</description>
  </rule>

  <rule id="100501" level="3">
    <if_sid>100500</if_sid>
    <field name="verdict">^consistent$</field>
    <description>Mecanismo: ativo conforme ao baseline, $(srcip) $(mac)</description>
    <group>mecanismo_conforme,</group>
  </rule>

  <rule id="100502" level="7">
    <if_sid>100500</if_sid>
    <field name="verdict">^inconclusive$</field>
    <description>Mecanismo: veredito inconclusivo, $(srcip) $(mac), requer analise</description>
    <group>mecanismo_analise,</group>
  </rule>

  <rule id="100510" level="12">
    <if_sid>100500</if_sid>
    <field name="verdict">^mismatch-possible-clone$</field>
    <description>Mecanismo: possivel clone de ativo autorizado, $(srcip) $(mac), contencao</description>
    <group>mecanismo_contencao,</group>
  </rule>

  <rule id="100511" level="12">
    <if_sid>100500</if_sid>
    <field name="verdict">^unauthorized-fingerprinted$</field>
    <description>Mecanismo: dispositivo nao autorizado identificado, $(srcip) $(mac), contencao</description>
    <group>mecanismo_contencao,</group>
  </rule>

  <rule id="100512" level="12">
    <if_sid>100500</if_sid>
    <field name="verdict">^unauthorized-unresolved$</field>
    <description>Mecanismo: dispositivo nao autorizado sem resposta, $(srcip) $(mac), contencao</description>
    <group>mecanismo_contencao,</group>
  </rule>

</group>
